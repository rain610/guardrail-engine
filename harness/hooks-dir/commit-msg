#!/bin/sh
# agentguard dispatcher · commit-msg（指纹标记：链式调用前检测自身，防自递归）
# guardrail-engine 工程 commit-msg：保护循环 + 维护提交复核提示
# 改受保护文件(checks/*.py, config/)但无 [harness] 标记 → 拦截；
# 有标记 → 放行但打 ⚠ 复核提示（2026-09-12：防 agent 提交消息带标记就绕过人工确认）。
set -e

# 把目录路径规范化成可比较的**物理**绝对路径（解析 `.`/`..`/符号链接）；不是目录则输出空串。
# 2026-11-04（评审 P1-1）：判定"本次提交是否属于引擎仓库族"要比较 git common-dir，而 common-dir
# 可能是相对形态（`.git`）或绝对形态（worktree 指回主仓），直接比字符串会漏判 → 统一规范化后再比。
_canon_dir() {
    [ -n "$1" ] && [ -d "$1" ] && (cd "$1" 2>/dev/null && pwd -P) || true
}

# ⚠ 自识守卫（N2 修复，第二轮评审）：本文件位于 harness/hooks-dir/，而该目录是**所有端仓**
# 的 core.hooksPath 共享分发器——端仓提交时本脚本也会被执行。若不判断"当前提交的是不是
# harness 工程仓本身"，它就会 cd 进工程仓去读**工程仓**的暂存区：轻则打出无关的复核提示，
# 重则因工程仓恰好有暂存的 .py/.yaml 而 exit 1，**阻断别人端仓的提交**。
# ⚠ 顺序很重要：必须在 `cd ENGROOT` **之前**取 TOP——git 以"被提交仓"的根为 cwd 运行 hook，
#    cd 之后再取就恒等于工程仓，守卫等于没加（初版就写反了，实测才发现）。
TOP=$(cd "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null && pwd) || exit 0
ENGROOT="$(cd "$(dirname "$0")/../.." && pwd)"
# ---- 评审 v8（Codex P1）：链式调用端仓原有 hook ---------------------------------
# 设置 core.hooksPath 会**整体接管** hook 目录，仓里原有的同名 hook 会静默失效。
# sandbox/install_hooks.sh 安装时会把它们备份到 <gitdir>/agentguard-original-hooks/，
# 这里在执行门禁**之前**调用同名备份 —— 接管不等于吞掉别人的质量流程。
# 评审 v9（Codex P1-2）：查找顺序必须与 pre-commit 一致 —— worktree 里真实共享 hooks 在
# **common-dir** 下，而 absolute-git-dir 指向 .git/worktrees/<名>（那里没有备份）→
# 旧写法只查后者的结果是"接管了、但端仓原有 commit-msg 被静默跳过"。
COMMON=$(git rev-parse --git-common-dir 2>/dev/null || echo "")
case "$COMMON" in
    /*|[A-Za-z]:[\\/]*) ;;
    * ) [ -n "$TOP" ] && COMMON="$TOP/$COMMON" ;;
esac
GITDIR=$(git rev-parse --absolute-git-dir 2>/dev/null || git rev-parse --git-dir 2>/dev/null || echo "")
ORIG=""
for _base in "$COMMON" "$GITDIR"; do
    [ -n "$_base" ] || continue
    if [ -f "$_base/agentguard-original-hooks/commit-msg" ]; then
        ORIG="$_base/agentguard-original-hooks/commit-msg"
        break
    fi
done
if [ -n "$ORIG" ] && head -2 "$ORIG" | grep -q "agentguard dispatcher" 2>/dev/null; then
    # 评审 v9（V9-7）：备份可能就是本分发器自己（重复安装/误备份）→ 链式调用会自递归。
    echo "[chain] ⚠ 备份命中本分发器指纹 → 跳过链式调用（防自递归）"
    ORIG=""
fi
if [ -n "$ORIG" ]; then
    echo "[chain] 调用端仓原有 commit-msg：$ORIG"
    if [ -x "$ORIG" ]; then "$ORIG" "$@"; else sh "$ORIG" "$@"; fi
    chained_rc=$?
    if [ "$chained_rc" -ne 0 ]; then
        echo "✗ 端仓原有 commit-msg 未通过（由 guardrail-engine 链式调用），本次提交已阻断。"
        exit "$chained_rc"
    fi
fi
# ------------------------------------------------------------------------------

# 引擎仓（= hook 脚本所在仓，主检出）的 common-dir。与上面 COMMON（本次提交仓的 common-dir）
# 比较，判"本次提交是否属于同一个仓库族"。git worktree 与其主检出**共享 common-dir**。
ENG_COMMON=$(git -C "$ENGROOT" rev-parse --git-common-dir 2>/dev/null || echo "")
case "$ENG_COMMON" in
    /*|[A-Za-z]:[\\/]*) ;;
    * ) [ -n "$ENG_COMMON" ] && ENG_COMMON="$ENGROOT/$ENG_COMMON" ;;
esac

# 只有"在提交引擎仓本身（主检出或其任一 worktree）"才需要 [harness] 把关；端仓提交直接放行。
# 2026-11-04（评审 P1-1）：原先只比字面工作树路径 `[ "$TOP" = "$ENGROOT" ]`。worktree 的 TOP
# （worktree 根）必然 ≠ ENGROOT（主检出根）→ 引擎仓的 worktree 提交在这里 exit 0，[harness] 把关
# 整体失效（复现 B）。改判仓库族：common-dir 相同即同族，worktree 与主检出一视同仁。
_is_engine_repo=0
if [ "$TOP" = "$ENGROOT" ]; then
    _is_engine_repo=1
else
    _c_top=$(_canon_dir "$COMMON")
    _c_eng=$(_canon_dir "$ENG_COMMON")
    if [ -n "$_c_top" ] && [ -n "$_c_eng" ] && [ "$_c_top" = "$_c_eng" ]; then
        _is_engine_repo=1
    fi
fi
[ "$_is_engine_repo" = 1 ] || exit 0

# git 传给 commit-msg 的 $1 是**相对路径**（实测 `.git/COMMIT_EDITMSG`，相对 hook 运行时 cwd=被提交仓根）。
# 2026-11-04（评审 P1-1 潜伏问题，复现 F）：必须在任何 cd 之前按 TOP 绝对化。原先脚本先 `cd "$ENGROOT"`
# 再读 `$1`，worktree 提交时会去读**主检出**的 .git/COMMIT_EDITMSG（可能还是上一次的旧消息）→ 误判。
# 同时不再 `cd "$ENGROOT"`：下面的暂存区查询一律用 `git -C "$TOP"`，确保读的是**本次提交仓**的索引
# （worktree 的索引与主检出各自独立），而受保护清单仍取自 ENGROOT（见下，规范源不许被 worktree 分支篡改）。
MSG_FILE="$1"
case "$MSG_FILE" in
    /*|[A-Za-z]:[\\/]*) ;;
    * ) [ -n "$MSG_FILE" ] && MSG_FILE="$TOP/$MSG_FILE" ;;
esac
if [ ! -f "$MSG_FILE" ]; then exit 0; fi
MSG=$(cat "$MSG_FILE")
# 暂存的改动里是否有受保护文件（排除 __pycache__/.pyc 构建产物）
# 2026-11-04（评审 P1-3 / P2-8）：受保护面清单收敛到 harness/protected-patterns.txt（唯一事实源），
# 与 checks/harness_guard._in_protected 共用同一份。原先这里手写 `\.(py|yaml)$|...`，只认旧扩展名，
# 漏掉 config/harness.toml、.github/workflows/*.yml、sandbox/*.sh、VERSION、pyproject.toml、
# setup.py、MANIFEST.in —— 与 guard 的清单漂移，于是一个无 [harness] 的提交能悄悄改策略/CI，
# 而 CI 的 Engine-Sha 校验又只在消息含 [harness] 时触发，连内容校验都一并跳过。
# 清单**故意**取自 ENGROOT（主检出）而非 TOP（本次提交仓）：worktree 可能在某条分支上把清单改弱/删空，
# 用规范源判定才不会被"正在提交的这份规则"自我豁免（暂存区读 TOP、规则读 ENGROOT 是刻意的分工）。
PATTERNS="$ENGROOT/harness/protected-patterns.txt"
if [ ! -f "$PATTERNS" ]; then
    # 清单缺失 = 无法判定本次提交是否触碰门禁文件 → fail-closed（报平安比报错危险）。
    echo "✗ 受保护清单缺失：$PATTERNS —— 无法判定是否触碰门禁文件，按 fail-closed 阻断本次提交。"
    echo "  这是工程仓/环境问题（清单被删或安装不完整），不是业务代码问题。"
    exit 1
fi
STAGED=$(git -C "$TOP" diff --cached --name-only | grep -v '__pycache__' || true)
CHANGED=""
if [ -n "$STAGED" ]; then
    # grep 退出码：0=有匹配 / 1=无匹配 / 2=出错（清单含非法 ERE）。set -e 下 rc=1 会中止脚本，
    # 故临时关掉；rc>1 视为清单损坏 → fail-closed，绝不静默放行。
    set +e
    CHANGED=$(printf '%s\n' "$STAGED" | grep -Ef "$PATTERNS")
    _prc=$?
    set -e
    if [ "$_prc" -gt 1 ]; then
        echo "✗ 受保护清单匹配失败（grep rc=$_prc，$PATTERNS 可能含非法正则）→ 按 fail-closed 阻断本次提交。"
        exit 1
    fi
fi
if [ -z "$CHANGED" ]; then
    exit 0  # 没改受保护文件，放行
fi
case "$MSG" in
    *"[harness]"*|*harness-maintenance*|*HARNESS:*)
        echo "⚠ [harness 复核提示] 本提交改动了门禁文件，请人工确认改动符合预期："
        echo "$CHANGED" | sed 's/^/    /'
        echo "  （门禁文件 = 所有提交强制检查的规则来源；确认无误可忽略本提示）"
        # 复杂度预算（2026-09-13 外部评审 v3 Q5 的可执行版本）：新增部件必须答上三问，
        # 否则别加 —— harness 自身零件数在快速增长，靠这句把关比靠自觉可靠。
        echo "  【新增部件三问】① 它消灭了哪个具体维护负担？② 它自己的锁/验收命令是什么？③ 它替代/简化了什么？"
        # 第四问（2026-09-13 外部评审 v4 的主题，很准）：新加的安全机制最容易在**边界上报平安**
        # （本轮 F1：判定器把 rc=2 当"拦下了"；F2：探针没写出来被当"模型偷懒"；F3：--accept 无约束）。
        echo "  【第四问】这个新机制在最坏/边界情形下会不会倾向报平安？（报平安比报错更危险）"
        exit 0;;  # 维护标记，放行 + 提示
esac
echo "✗ 本次改动触碰受保护的 harness 文件(checks/*.py / config) 但提交消息无 [harness] 标记。"
echo "  确认是 harness 维护请重试：git commit -m \"[harness] <说明>\""
exit 1
